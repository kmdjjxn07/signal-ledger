# 시그널 원장 환경 설정 예시. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 비밀값은 절대 Git에 올리지 마세요(.gitignore에 .env 포함).

SL_ENV=development
# 개발: SQLite 파일(설치 불필요). 운영: PostgreSQL 예) postgresql+psycopg://user:pass@host:5432/signal_ledger
SL_DATABASE_URL=
SL_DATA_DIR=
# HTTPS로 배포할 때 true
SL_COOKIE_SECURE=false
SL_SESSION_HOURS=12
SL_HTTP_TIMEOUT=8

# --- 무료 자동 실행(GitHub Actions + 공개 저장소)을 쓸 때 ---
# editor  : 이 컴퓨터 화면의 입력을 inbox/ 제출 파일로만 저장(GitHub 실행기가 검증·반영). 보유종목은 이 컴퓨터에만.
# direct  : 이 컴퓨터 DB에 바로 반영(서버를 직접 계속 켜 둘 때)
SL_MODE=editor
# 공개 저장소의 공급자 자료(종목·KRX 가격·시세)를 암호화하는 열쇠. python -m app.ci gen-key 로 만들고
# GitHub Secrets의 SL_STATE_KEY와 같은 값을 넣으세요. KRX 키를 GitHub에 넣으려면 반드시 필요합니다.
SL_STATE_KEY=

# --- 데이터 공급자 (비워 두면 화면에 '연결 필요'로 표시) ---
# KRX 정보데이터시스템 Open API 인증키 (공식 일별 가격, A등급)
KRX_API_KEY=
# DART Open API 인증키 (공시, A등급)
DART_API_KEY=
# FRED API 키 (미국 금리·지수·유가, B등급)
FRED_API_KEY=
# 네이버 공개 시세 원본: 이용조건을 직접 확인한 뒤에만 true
NAVER_QUOTE_ENABLED=false

# --- AI 판단기 (Gemini) ---
GEMINI_API_KEY=
# 사용할 모델 이름을 직접 지정(예시를 가정하지 않음)
GEMINI_MODEL=
